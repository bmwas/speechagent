# --- LiveKit SFU (speechagent ports — msestream keeps 7880/5173/7860) ---
LIVEKIT_API_KEY=P1TUmYPfJJP2BYZs4M5nN8v32TGBA+8w
LIVEKIT_API_SECRET=P1TUmYPfJJP2BYZs4M5nN8v32TGBA+8w
LIVEKIT_URL=ws://127.0.0.1:8880
# Empty = browser uses same-origin wss://<capture-ui>/rtc (serve.mjs proxy).
LIVEKIT_PUBLIC_URL=
LIVEKIT_PORT=8880
LIVEKIT_TCP_PORT=8881
LIVEKIT_TURN_PORT=8882
LIVEKIT_RTC_PORT_START=51000
LIVEKIT_RTC_PORT_END=51100

# --- Network (set these ON THE GPU SERVER) ---
# GPU box LAN IP so LiveKit advertises reachable ICE/TURN candidates.
# On that box: hostname -I | awk '{print $1}'
MSE_LAN_IP=192.168.1.34
LIVEKIT_NODE_IP=192.168.1.34

# Host nvidia-smi index of the RTX 6000 Ada 48 GB (msestream: 0=Blackwell, 1=Ada).
ADA_GPU_INDEX=1
# Before vLLM loads, stop other containers/PIDs on Ada (msestream interviewer-engine,
# observer-engine, llama.cpp). Blackwell / sglang on GPU 0 is left alone.
# Set 0 to skip. MSE interview voice on Ada stays down until you start those engines again.
FREE_ADA_GPU=1

# --- Model ---
# openbmb/MiniCPM-o-4_5   full-duplex (best natural conversation)
# Qwen/Qwen2.5-Omni-3B    turn-based (lighter VRAM)
MODEL_NAME=openbmb/MiniCPM-o-4_5
MODEL_PORT=8199
MODEL_BASE_URL=http://127.0.0.1:8199
# Used only when no deploy YAML is found. MiniCPM uses model-server/deploy/.
GPU_MEMORY_UTILIZATION=0.85
MAX_MODEL_LEN=2048
# Hub auth: HUGGINGFACE_TOKEN from the GPU-box ~/.bashrc. Never store it here.

# --- Agent ---
AGENT_PORT=8860
AGENT_SYSTEM_PROMPT=You are a helpful, friendly AI assistant. You can see the user through their camera and hear them through their microphone. Respond naturally and conversationally. Keep responses concise and engaging.

# --- Voice ---
# MiniCPM-o 4.5: 16 kHz mono WAV, 3-10 s. Empty = model bundled HT_ref_audio.wav
REF_AUDIO_PATH=
# Qwen2.5-Omni-3B built-in speaker: Chelsie (female) or Ethan (male)
QWEN_SPEAKER=Chelsie

# --- Real-Time Tuning ---
AUDIO_SOURCE_QUEUE_MS=120
VAD_START_SECS=0.15
VAD_STOP_SECS=0.80
VAD_MIN_VOLUME=0.01
VAD_CONFIDENCE=0.5
VIDEO_FPS=1
AUDIO_CHUNK_MS=100

# --- Frontend (HTTPS mux; msestream already owns :5173) ---
FRONTEND_PORT=6173

# --- Observability (msestream already owns :3000 and :3100) ---
LOG_LEVEL=INFO
GRAFANA_PORT=3300
LOKI_PORT=3310
TRACE_DEBUG=1
STREAM_TRACE=1
STREAM_TRACE_PERIOD_S=1
COMPOSE_PROJECT_NAME=speechagent
