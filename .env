# --- LiveKit SFU (speechagent ports — msestream keeps 7880/5173/7860) ---
LIVEKIT_API_KEY=P1TUmYPfJJP2BYZs4M5nN8v32TGBA+8w
LIVEKIT_API_SECRET=P1TUmYPfJJP2BYZs4M5nN8v32TGBA+8w
LIVEKIT_URL=ws://127.0.0.1:8880
# Empty = browser uses same-origin wss://<capture-ui>/rtc (serve.mjs proxy).
LIVEKIT_PUBLIC_URL=
LIVEKIT_PORT=8880
LIVEKIT_TCP_PORT=8881
LIVEKIT_TURN_PORT=8882
LIVEKIT_RTC_PORT_START=51000
LIVEKIT_RTC_PORT_END=51100

# --- Network (set these ON THE GPU SERVER) ---
# GPU box LAN IP so LiveKit advertises reachable ICE/TURN candidates.
# Precision is 10.4.7.193 (not this laptop). LiveKit entrypoint overrides
# NODE_IP if the value is not an address on the host.
MSE_LAN_IP=10.4.7.193
LIVEKIT_NODE_IP=10.4.7.193

# Host nvidia-smi index of the RTX 6000 Ada 48 GB (msestream: 0=Blackwell, 1=Ada).
ADA_GPU_INDEX=1
# Before vLLM loads, stop other containers/PIDs on Ada (msestream interviewer-engine,
# observer-engine, llama.cpp). Blackwell / sglang on GPU 0 is left alone.
# Set 0 to skip. MSE interview voice on Ada stays down until you start those engines again.
FREE_ADA_GPU=1

# --- Model ---
# openbmb/MiniCPM-o-4_5   full-duplex realtime (best-so-far: git tag best-so-far, native)
# Qwen3-Omni-30B-A3B      realtime /v1/video/chat/stream (vLLM :8199). The
#   Qwen2.5-Omni audio path is turn-based only (no streaming audio), so the
#   realtime Omni Qwen path is Qwen3-Omni. No small Qwen3-Omni exists; the
#   30B-A3B MoE only fits this 48 GB Ada as a thinker-only 4-bit checkpoint.
# Trial 2026-10-25: Qwen3-Omni 4-bit. Restore MiniCPM with tag best-so-far.
MODEL_NAME=cyankiwi/Qwen3-Omni-30B-A3B-Instruct-AWQ-4bit
# vllm = vLLM-Omni on :8199 (MiniCPM duplex or Qwen). native = OpenBMB
# PyTorch worker on :22400 (MiniCPM only). COMPOSE_PROFILES must match.
# Do not set both profiles — Ada cannot hold vLLM and the PyTorch worker.
MODEL_BACKEND=vllm
COMPOSE_PROFILES=vllm
MODEL_PORT=8199
MODEL_BASE_URL=http://127.0.0.1:8199
# silero = LiveKit bundled inference.VAD (default). energy = RMS hangover.
VAD_BACKEND=silero
# Used only when no deploy YAML is found. MiniCPM uses model-server/deploy/.
GPU_MEMORY_UTILIZATION=0.85
MAX_MODEL_LEN=2048
# Hub auth: HUGGINGFACE_TOKEN from the GPU-box ~/.bashrc. Never store it here.

# --- Agent ---
AGENT_PORT=8860
# MiniCPM-o 4.5: official English clone prompt. Language is selected here,
# not by HT_ref_audio.wav. After a context overflow the model otherwise
# falls back to Chinese.
AGENT_SYSTEM_PROMPT=Clone the voice in the provided audio prompt. Please assist users while maintaining this voice style. Please answer the user's questions seriously and in a high quality. Please chat with the user in a highly human-like and oral style. You can see the user through their camera and hear them through their microphone. Always reply in English. Never switch to Chinese unless the user is speaking Chinese. Keep responses concise. You are a helpful assistant developed by ModelBest: MiniCPM-Omni.

# --- Voice ---
# MiniCPM-o 4.5: 16 kHz mono WAV, 3-10 s. Empty = snapshot assets/HT_ref_audio.wav
# (v0.30.0 duplex will not speak without this).
REF_AUDIO_PATH=
# Qwen2.5-Omni-3B built-in speaker: Chelsie (female) or Ethan (male)
QWEN_SPEAKER=Chelsie

# --- Real-Time Tuning ---
AUDIO_SOURCE_QUEUE_MS=80
VAD_START_SECS=0.15
VAD_STOP_SECS=0.80
# MiniCPM commits on VAD stop; 0.80 s chops mid-thought pauses into extra
# commits and the model `listen`s (user has to repeat). Qwen still uses 0.80.
MINICPM_VAD_STOP_SECS=1.2
VAD_MIN_VOLUME=0.01
VAD_CONFIDENCE=0.5
VIDEO_FPS=1
VIDEO_MAX_SIDE=448
AUDIO_CHUNK_MS=100
# Native MiniCPM duplex (ignored by vLLM). Locked with tag best-so-far.
# 1 s units; 300 s reconnect cap. listen_prob_scale MUST stay 1.0 —
# values <1 make the model ramble and never return the floor.
NATIVE_CHUNK_MS=1000
NATIVE_SESSION_S=300
NATIVE_TTS_REF_MAX_S=10
NATIVE_LISTEN_PROB_SCALE=1.0
NATIVE_SPEAK_YIELD_N=10
NATIVE_SPEAK_BARGE_N=2
NATIVE_LISTEN_LOCK_N=5

# --- Playout jitter buffer ---
# While the model is generating, gaps are filled with silence (no rebuffer).
# HOLD only covers the tail after generation stops.
PLAYOUT_START_MS=150
PLAYOUT_REBUFFER_MS=150
PLAYOUT_HOLD_S=0.40
# Short model deltas must not sit behind the prebuffer gate for 3 seconds.
PLAYOUT_MAX_WAIT_MS=300
BOT_AUDIBLE_GRACE_MS=120

# --- Stall cancel ---
# How long (ms) to wait before cancelling a stalled response. HiFT eager
# fallback pauses are 5-30 s; set above that to avoid chopping real speech.
STALL_CANCEL_MS=45000
# Qwen2.5-Omni live /v1/video/chat/stream (ignored by MiniCPM duplex)
QWEN_VIDEO_FPS=5
QWEN_VIDEO_NUM_FRAMES=40
QWEN_VIDEO_MAX_FRAMES=50
QWEN_VIDEO_MAX_SIDE=448
# Reopen the video-stream socket if a query produces text but no PCM.
QWEN_STALL_S=12

# --- Frontend (HTTPS mux; msestream already owns :5173) ---
FRONTEND_PORT=6173

# --- Observability (msestream already owns :3000 and :3100) ---
LOG_LEVEL=INFO
GRAFANA_PORT=3300
LOKI_PORT=3310
TRACE_DEBUG=1
STREAM_TRACE=1
STREAM_TRACE_PERIOD_S=1
# Per-packet / 10 Hz pipeline traces (WS rx/tx, every delta, ring samples).
# Set 0 to fall back to 1 Hz aggregation.
TRACE_HIRES=1
# Batch trace stdout writes on a background thread so 50 Hz frame logging
# cannot block the realtime asyncio loop.
TRACE_ASYNC_WRITE=1
TRACE_QUEUE_MAX=20000
TRACE_BATCH_MAX=256
TRACE_FLUSH_MS=20
# Ada nvidia-smi sampler (query only, no VRAM). Grafana: /d/speechagent-gpu
GPU_STATS_INTERVAL_S=2
GPU_STATS_SUMMARY_S=30
GPU_STATS_VERDICT_S=300
COMPOSE_PROJECT_NAME=speechagent
