{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "title": "Agent traces",
      "type": "link",
      "url": "/d/speechagent-traces/agent-traces",
      "icon": "dashboard"
    },
    {
      "title": "Realtime stream",
      "type": "link",
      "url": "/d/speechagent-stream/realtime-stream",
      "icon": "bolt"
    },
    {
      "title": "Ada GPU",
      "type": "link",
      "url": "/d/speechagent-gpu/ada-gpu",
      "icon": "monitor"
    },
    {
      "title": "Audio pipeline debug",
      "type": "link",
      "url": "/d/speechagent-audio-pipeline/audio-pipeline-debug",
      "icon": "bug"
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Log volume by service",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 16, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "unit": "cps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (service) (count_over_time({compose_project=\"speechagent\"}[1m]))",
          "legendFormat": "{{service}}",
          "queryType": "range",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Model-server errors (range)",
      "type": "stat",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "model errors",
          "expr": "sum(count_over_time({compose_project=\"speechagent\", service=\"model-server\"} |~ \"(?i)ERROR |ValueError|Traceback|Orchestrator initialization failed|No available memory|StageEngineCoreProc failed|ModuleNotFoundError|s3tokenizer\" [$__range]))"
        }
      ]
    },
    {
      "id": 2,
      "title": "Errors / traceback / KV cache / CUDA",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 7 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "expr": "{compose_project=\"speechagent\"} |~ \"(?i)ERROR |ValueError|Traceback|fatal|Orchestrator initialization failed|No available memory|StageEngineCoreProc failed|ModuleNotFoundError|s3tokenizer|duplex.ws_retry|drop_not_ready|error\\\\.\"",
          "queryType": "range",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Agent",
      "type": "logs",
      "gridPos": { "h": 12, "w": 12, "x": 0, "y": 17 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending" },
      "targets": [{ "expr": "{compose_project=\"speechagent\", service=\"agent\"}", "queryType": "range", "refId": "A" }]
    },
    {
      "id": 4,
      "title": "Model server",
      "type": "logs",
      "gridPos": { "h": 12, "w": 12, "x": 12, "y": 17 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending" },
      "targets": [{ "expr": "{compose_project=\"speechagent\", service=\"model-server\"}", "queryType": "range", "refId": "A" }]
    },
    {
      "id": 5,
      "title": "LiveKit",
      "type": "logs",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 29 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending" },
      "targets": [{ "expr": "{compose_project=\"speechagent\", service=\"livekit\"}", "queryType": "range", "refId": "A" }]
    },
    {
      "id": 6,
      "title": "Frontend",
      "type": "logs",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 29 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending" },
      "targets": [{ "expr": "{compose_project=\"speechagent\", service=\"frontend\"}", "queryType": "range", "refId": "A" }]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["speechagent"],
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "browser",
  "title": "Agent logs",
  "uid": "speechagent-logs",
  "version": 1
}
