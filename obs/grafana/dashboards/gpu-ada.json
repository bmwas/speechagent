  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Ada now (gpu.sample)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "id": 2,
      "title": "VRAM used",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name"
      },
      "fieldConfig": { "defaults": { "unit": "decgbytes", "decimals": 2 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "used GiB",
          "expr": "avg_over_time({compose_project=\"speechagent\", event=\"gpu.sample\"} | json | unwrap mem_used_gib | __error__=\"\" [$__interval])"
        }
      ]
    },
    {
      "id": 3,
      "title": "Headroom",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "loki", "uid": "loki" },
