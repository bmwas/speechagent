{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 2,
  "links": [
    { "title": "Agent logs", "type": "link", "url": "/d/speechagent-logs/agent-logs", "icon": "doc" },
    { "title": "Realtime stream", "type": "link", "url": "/d/speechagent-stream/realtime-stream", "icon": "bolt" },
    { "title": "Ada GPU", "type": "link", "url": "/d/speechagent-gpu/ada-gpu", "icon": "monitor" }
  ],
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Audio pipeline health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "id": 1,
      "title": "RTF (real-time factor) — must stay above 1.0",
      "description": "Audio produced / wall time.  RTF < 1 = model slower than realtime = underruns are inevitable.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "pointSize": 4, "showPoints": "auto" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 0.8 }, { "color": "green", "value": 1.0 } ] }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "RTF",
          "expr": "avg_over_time({compose_project=\"speechagent\", event=\"duplex.delta_timing\"} | json | unwrap rtf | __error__=\"\" [30s])"
        }
      ]
    },
    {
      "id": 2,
      "title": "Inter-delta gap (ms) — normal 200-400, HiFT eager 5000-30000",
      "description": "Time between consecutive audio deltas.  Spikes above 4000 ms are HiFT eager fallback.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "drawStyle": "bars", "fillOpacity": 30, "lineWidth": 1 },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 1000 }, { "color": "red", "value": 5000 } ] },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "gap_ms",
          "expr": "max_over_time({compose_project=\"speechagent\", event=\"duplex.delta_timing\"} | json | unwrap gap_ms | __error__=\"\" [15s])"
        }
      ]
    },
    {
      "id": 3,
      "title": "Playout ring buffer (ms)",
      "description": "Audio sitting in the ring waiting to be played.  Drops to 0 = underrun.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2 },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 50 }, { "color": "green", "value": 150 } ] },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "health",
          "legendFormat": "ring_ms (health)",
          "expr": "avg_over_time({compose_project=\"speechagent\", event=\"stream.health\"} | json | unwrap ring_ms | __error__=\"\" [15s])"
        },
        {
          "refId": "pull",
          "legendFormat": "ring_ms (pull)",
          "expr": "avg_over_time({compose_project=\"speechagent\", event=\"pull.chunk\"} | json | unwrap ring_ms | __error__=\"\" [15s])"
        },
        {
          "refId": "sample",
          "legendFormat": "ring_ms (10 Hz sample)",
          "expr": "avg_over_time({compose_project=\"speechagent\", event=\"playout.ring_sample\"} | json | unwrap ring_ms | __error__=\"\" [5s])"
        }
      ]
    },
    {
      "id": 4,
      "title": "Underruns + stalls + cancels (count/min)",
      "description": "Each of these is an audible disruption.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "unit": "cpm" }, "overrides": [] },
      "targets": [
        {
          "refId": "underrun",
          "legendFormat": "playout.underrun",
          "expr": "sum(count_over_time({compose_project=\"speechagent\", event=\"playout.underrun\"}[1m]))"
        },
        {
          "refId": "stall",
          "legendFormat": "stream.stall",
          "expr": "sum(count_over_time({compose_project=\"speechagent\", event=\"stream.stall\"}[1m]))"
        },
        {
          "refId": "cancel",
          "legendFormat": "duplex.stall_cancel",
          "expr": "sum(count_over_time({compose_project=\"speechagent\", event=\"duplex.stall_cancel\"}[1m]))"
        },
        {
          "refId": "reconnect",
          "legendFormat": "duplex.reconnect",
          "expr": "sum(count_over_time({compose_project=\"speechagent\", event=\"duplex.reconnect\"}[1m]))"
        },
        {
          "refId": "overflow",
          "legendFormat": "context_overflow",
          "expr": "sum(count_over_time({compose_project=\"speechagent\", event=\"duplex.context_overflow\"}[1m]))"
        },
        {
          "refId": "dead",
          "legendFormat": "duplex.dead_session",
          "expr": "sum(count_over_time({compose_project=\"speechagent\", event=\"duplex.dead_session\"}[1m]))"
        }
      ]
    },
    {
      "id": 101,
      "type": "row",
      "title": "Per-turn stats",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "collapsed": false
    },
    {
      "id": 5,
      "title": "Turn audio duration (ms) vs wall time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "refId": "audio",
          "legendFormat": "turn_audio_ms",
          "expr": "avg_over_time({compose_project=\"speechagent\", event=\"duplex.response_done\"} | json | unwrap turn_audio_ms | __error__=\"\" [1m])"
        },
        {
          "refId": "speak",
          "legendFormat": "speak_ms (wall)",
          "expr": "avg_over_time({compose_project=\"speechagent\", event=\"duplex.response_done\"} | json | unwrap speak_ms | __error__=\"\" [1m])"
        },
        {
          "refId": "max_gap",
          "legendFormat": "turn_max_gap_ms",
          "expr": "max_over_time({compose_project=\"speechagent\", event=\"duplex.response_done\"} | json | unwrap turn_max_gap_ms | __error__=\"\" [1m])"
        }
      ]
    },
    {
      "id": 6,
      "title": "Playout turn summary",
      "description": "Per-turn: frames played, silence frames, underrun episodes, longest underrun.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "refId": "longest",
          "legendFormat": "longest_underrun_ms",
          "expr": "max_over_time({compose_project=\"speechagent\", event=\"playout.turn_summary\"} | json | unwrap longest_underrun_ms | __error__=\"\" [1m])"
        },
        {
          "refId": "total",
          "legendFormat": "underrun_total_ms",
          "expr": "sum_over_time({compose_project=\"speechagent\", event=\"playout.turn_summary\"} | json | unwrap underrun_total_ms | __error__=\"\" [1m])"
        },
        {
          "refId": "ring_min",
          "legendFormat": "ring_ms_min",
          "expr": "min_over_time({compose_project=\"speechagent\", event=\"playout.turn_summary\"} | json | unwrap ring_ms_min | __error__=\"\" [1m])"
        }
      ]
    },
    {
      "id": 102,
      "type": "row",
      "title": "Prebuffer + speaking state",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "collapsed": false
    },
    {
      "id": 7,
      "title": "Prebuffer gate events",
      "description": "resume = gate opened after prebuffer filled.  prebuffer-clear = gate reset by barge-in.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 27 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "unit": "cpm" }, "overrides": [] },
      "targets": [
        {
          "refId": "resume",
          "legendFormat": "playout.resume",
          "expr": "sum(count_over_time({compose_project=\"speechagent\", event=\"playout.resume\"}[1m]))"
        },
        {
          "refId": "clear",
          "legendFormat": "playout.clear",
          "expr": "sum(count_over_time({compose_project=\"speechagent\", event=\"playout.clear\"}[1m]))"
        },
        {
          "refId": "first_frame",
          "legendFormat": "playout.first_frame",
          "expr": "sum(count_over_time({compose_project=\"speechagent\", event=\"playout.first_frame\"}[1m]))"
        },
        {
          "refId": "idle",
          "legendFormat": "playout.idle",
          "expr": "sum(count_over_time({compose_project=\"speechagent\", event=\"playout.idle\"}[1m]))"
        }
      ]
    },
    {
      "id": 8,
      "title": "Speaking state transitions",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 27 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "unit": "cpm" }, "overrides": [] },
      "targets": [
        {
          "refId": "speak",
          "legendFormat": "duplex.speak",
          "expr": "sum(count_over_time({compose_project=\"speechagent\", event=~\"duplex\\\\.speak\"}[1m]))"
        },
        {
          "refId": "listen",
          "legendFormat": "duplex.listen",
          "expr": "sum(count_over_time({compose_project=\"speechagent\", event=\"duplex.listen\"}[1m]))"
        },
        {
          "refId": "cancel",
          "legendFormat": "duplex.cancel",
          "expr": "sum(count_over_time({compose_project=\"speechagent\", event=\"duplex.cancel\"}[1m]))"
        },
        {
          "refId": "barge",
          "legendFormat": "turn.barge_in",
          "expr": "sum(count_over_time({compose_project=\"speechagent\", event=\"turn.barge_in\"}[1m]))"
        },
        {
          "refId": "done",
          "legendFormat": "duplex.response_done",
          "expr": "sum(count_over_time({compose_project=\"speechagent\", event=\"duplex.response_done\"}[1m]))"
        }
      ]
    },
    {
      "id": 103,
      "type": "row",
      "title": "Raw diagnostic logs",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 35 },
      "collapsed": false
    },
    {
      "id": 9,
      "title": "Delta timing (gap, dur, RTF per delta)",
      "type": "logs",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 36 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending", "dedupStrategy": "none" },
      "targets": [
        {
          "expr": "{compose_project=\"speechagent\", event=~\"duplex\\\\.delta_timing|duplex\\\\.first_audio|duplex\\\\.response_done\"}",
          "queryType": "range",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Playout events (underrun, resume, idle, clear, turn_summary)",
      "type": "logs",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 36 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending", "dedupStrategy": "none" },
      "targets": [
        {
          "expr": "{compose_project=\"speechagent\", event=~\"playout\\\\.(underrun|recover|resume|idle|first_frame|clear|turn_summary|clock_slip|capture_timeout|buffering|push|ring_sample)\"}",
          "queryType": "range",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Stalls + cancels + reconnects + context overflow",
      "type": "logs",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 46 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending", "dedupStrategy": "none" },
      "targets": [
        {
          "expr": "{compose_project=\"speechagent\", event=~\"stream\\\\.stall|duplex\\\\.(stall_cancel|cancel|reconnect.*|context_overflow|ws_close|dead_session|turn_decision|session_ready)|error\\\\.(duplex.*|brain|playout.*)\"}",
          "queryType": "range",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "title": "Pull loop + speak/listen transitions",
      "type": "logs",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 46 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending", "dedupStrategy": "none" },
      "targets": [
        {
          "expr": "{compose_project=\"speechagent\", event=~\"pull\\\\.(chunk|empty)|playout\\\\.source_active_change|duplex\\\\.(speak|listen|response_done|response_created)|stream\\\\.(user_utt_start|user_utt_end)|turn\\\\.barge_in\"}",
          "queryType": "range",
          "refId": "A"
        }
      ]
    },
    {
      "id": 104,
      "type": "row",
      "title": "Packet timeline (TRACE_HIRES)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 56 },
      "collapsed": false
    },
    {
      "id": 13,
      "title": "Packet timeline — every stream event",
      "description": "Primary debug view. Every SA_TRACE stream event with mono_ms relative clock.",
      "type": "logs",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 57 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": false, "enableLogDetails": true, "sortOrder": "Descending", "dedupStrategy": "none" },
      "timeFrom": "2m",
      "targets": [
        {
          "expr": "{compose_project=\"speechagent\", lane=\"stream\"}",
          "queryType": "range",
          "refId": "A",
          "maxLines": 5000
        }
      ]
    },
    {
      "id": 14,
      "title": "WS message timeline (rx + tx)",
      "type": "logs",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 69 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending", "dedupStrategy": "none" },
      "timeFrom": "2m",
      "targets": [
        {
          "expr": "{compose_project=\"speechagent\", event=~\"duplex\\\\.ws_rx|duplex\\\\.ws_tx\"}",
          "queryType": "range",
          "refId": "A",
          "maxLines": 5000
        }
      ]
    },
    {
      "id": 15,
      "title": "Ring depth (sub-second, 10 Hz)",
      "description": "playout.ring_sample every 100 ms. Drops to 0 immediately before an underrun.",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 69 },
      "datasource": { "type": "loki", "uid": "loki" },
      "timeFrom": "5m",
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 1, "pointSize": 3, "showPoints": "auto" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 50 }, { "color": "green", "value": 150 } ] },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "ring_ms",
          "expr": "avg_over_time({compose_project=\"speechagent\", event=\"playout.ring_sample\"} | json | unwrap ring_ms | __error__=\"\" [2s])"
        }
      ]
    },
    {
      "id": 16,
      "title": "Delta packet timeline",
      "type": "logs",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 79 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending", "dedupStrategy": "none" },
      "timeFrom": "2m",
      "targets": [
        {
          "expr": "{compose_project=\"speechagent\", event=~\"duplex\\\\.delta_timing|duplex\\\\.first_audio\"}",
          "queryType": "range",
          "refId": "A",
          "maxLines": 5000
        }
      ]
    },
    {
      "id": 17,
      "title": "Mic append timeline",
      "type": "logs",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 79 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending", "dedupStrategy": "none" },
      "timeFrom": "2m",
      "targets": [
        {
          "expr": "{compose_project=\"speechagent\", event=~\"duplex\\\\.append|duplex\\\\.mic_drop|duplex\\\\.commit\"}",
          "queryType": "range",
          "refId": "A",
          "maxLines": 5000
        }
      ]
    },
    {
      "id": 18,
      "title": "Source-active + pull timeline",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 89 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending", "dedupStrategy": "none" },
      "timeFrom": "2m",
      "targets": [
        {
          "expr": "{compose_project=\"speechagent\", event=~\"pull\\\\.(chunk|empty)|playout\\\\.source_active_change\"}",
          "queryType": "range",
          "refId": "A",
          "maxLines": 5000
        }
      ]
    },
    {
      "id": 105,
      "type": "row",
      "title": "Continuous frame-level diagnostics",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 99 },
      "collapsed": false
    },
    {
      "id": 19,
      "title": "Playout frames/sec by kind",
      "description": "Every emitted 20 ms frame. real/real_padded is speech; prebuffer_silence and underrun_silence are generated silence.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 100 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{kind}}",
          "expr": "sum by (kind) (count_over_time({compose_project=\"speechagent\", event=\"playout.frame\"} | json [1s]))"
        }
      ]
    },
    {
      "id": 20,
      "title": "Real audio vs generated silence (frames/5s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 100 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "real",
          "legendFormat": "real audio",
          "expr": "sum(count_over_time({compose_project=\"speechagent\", event=\"playout.frame\"} | json | kind=~\"real.*\" [5s]))"
        },
        {
          "refId": "silence",
          "legendFormat": "generated silence",
          "expr": "sum(count_over_time({compose_project=\"speechagent\", event=\"playout.frame\"} | json | kind=~\".*silence\" [5s]))"
        }
      ]
    },
    {
      "id": 21,
      "title": "LiveKit capture blocking + queued audio",
      "description": "Every outbound 20 ms frame. block_ms reveals SDK backpressure; queued_ms reveals hidden AudioSource buffering.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 108 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "refId": "block",
          "legendFormat": "capture block_ms",
          "expr": "max_over_time({compose_project=\"speechagent\", event=\"livekit.capture\"} | json | unwrap block_ms | __error__=\"\" [2s])"
        },
        {
          "refId": "queue",
          "legendFormat": "AudioSource queued_ms",
          "expr": "max_over_time({compose_project=\"speechagent\", event=\"livekit.capture\"} | json | unwrap queued_ms | __error__=\"\" [2s])"
        }
      ]
    },
    {
      "id": 22,
      "title": "Prebuffer wait and fill",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 108 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "refId": "wait",
          "legendFormat": "waited_ms",
          "expr": "max_over_time({compose_project=\"speechagent\", event=\"playout.resume\"} | json | unwrap waited_ms | __error__=\"\" [10s])"
        },
        {
          "refId": "fill",
          "legendFormat": "fill_ms",
          "expr": "max_over_time({compose_project=\"speechagent\", event=\"playout.buffering\"} | json | unwrap fill_ms | __error__=\"\" [2s])"
        }
      ]
    },
    {
      "id": 23,
      "title": "HiFT / CFM graph capture and eager fallback",
      "description": "Model-server events that can block Code2Wav and create multi-second output gaps.",
      "type": "logs",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 116 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending", "dedupStrategy": "none" },
      "targets": [
        {
          "expr": "{compose_project=\"speechagent\", service=\"model-server\"} |~ \"Lazily capturing|Captured HiFT|Captured CFM|Falling back to eager\"",
          "queryType": "range",
          "refId": "A",
          "maxLines": 5000
        }
      ]
    },
    {
      "id": 24,
      "title": "Speech during model dead air (cancel avoided)",
      "description": "User speech while generating=true but no real bot audio is audible. These turns are no longer falsely cancelled.",
      "type": "logs",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 116 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending", "dedupStrategy": "none" },
      "targets": [
        {
          "expr": "{compose_project=\"speechagent\", event=~\"turn\\\\.barge_in|duplex\\\\.cancel|duplex\\\\.audio_drop\"}",
          "queryType": "range",
          "refId": "A",
          "maxLines": 5000
        }
      ]
    },
    {
      "id": 25,
      "title": "Every playout + LiveKit output frame",
      "type": "logs",
      "gridPos": { "h": 12, "w": 16, "x": 0, "y": 126 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": false, "enableLogDetails": true, "sortOrder": "Descending", "dedupStrategy": "none" },
      "timeFrom": "2m",
      "targets": [
        {
          "expr": "{compose_project=\"speechagent\", event=~\"playout\\\\.frame|livekit\\\\.capture\"}",
          "queryType": "range",
          "refId": "A",
          "maxLines": 10000
        }
      ]
    },
    {
      "id": 26,
      "title": "Trace writer health",
      "description": "Any value above zero means stdout/Loki could not keep up and trace lines were dropped.",
      "type": "timeseries",
      "gridPos": { "h": 12, "w": 8, "x": 16, "y": 126 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "drops",
          "legendFormat": "dropped trace lines",
          "expr": "max_over_time({compose_project=\"speechagent\", lane=\"stream\"} | json | unwrap trace_queue_dropped | __error__=\"\" [10s])"
        },
        {
          "refId": "depth",
          "legendFormat": "writer queue depth",
          "expr": "max_over_time({compose_project=\"speechagent\", lane=\"stream\"} | json | unwrap trace_queue_depth | __error__=\"\" [2s])"
        }
      ]
    },
    {
      "id": 27,
      "title": "Every mic input + VAD decision frame",
      "description": "LiveKit packet, post-resample agent packet, and VAD decision for every incoming audio frame.",
      "type": "logs",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 138 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": false, "enableLogDetails": true, "sortOrder": "Descending", "dedupStrategy": "none" },
      "timeFrom": "2m",
      "targets": [
        {
          "expr": "{compose_project=\"speechagent\", event=~\"livekit\\\\.audio_in|stream\\\\.mic_packet|vad\\\\.frame\"}",
          "queryType": "range",
          "refId": "A",
          "maxLines": 10000
        }
      ]
    },
    {
      "id": 106,
      "type": "row",
      "title": "Dead-session recovery",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 150 },
      "collapsed": false
    },
    {
      "id": 28,
      "title": "Commit to model decision (ms)",
      "description": "Time from input_audio_buffer.commit to listen/speak/first-audio/error. Native listen is a valid decision.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 151 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "refId": "avg",
          "legendFormat": "avg commit→decision",
          "expr": "avg_over_time({compose_project=\"speechagent\", event=\"duplex.turn_decision\"} | json | unwrap commit_to_decision_ms | __error__=\"\" [1m])"
        },
        {
          "refId": "max",
          "legendFormat": "max commit→decision",
          "expr": "max_over_time({compose_project=\"speechagent\", event=\"duplex.turn_decision\"} | json | unwrap commit_to_decision_ms | __error__=\"\" [1m])"
        }
      ]
    },
    {
      "id": 29,
      "title": "Dead-session reconnects + hidden-state crashes",
      "description": "Client watchdog reconnects when a commit gets no listen/speak/audio. Hidden-state errors come from the model-server log.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 151 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "unit": "cpm" }, "overrides": [] },
      "targets": [
        {
          "refId": "dead",
          "legendFormat": "duplex.dead_session",
          "expr": "sum(count_over_time({compose_project=\"speechagent\", event=\"duplex.dead_session\"}[1m]))"
        },
        {
          "refId": "reconnect",
          "legendFormat": "duplex.reconnect",
          "expr": "sum(count_over_time({compose_project=\"speechagent\", event=\"duplex.reconnect\"}[1m]))"
        },
        {
          "refId": "hidden",
          "legendFormat": "missing own-token hidden states",
          "expr": "sum(count_over_time({compose_project=\"speechagent\"} |= \"missing own-token hidden states\" [1m]))"
        }
      ]
    },
    {
      "id": 30,
      "title": "Dead-session + hidden-state logs",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 159 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending", "dedupStrategy": "none" },
      "targets": [
        {
          "expr": "{compose_project=\"speechagent\"} |~ \"duplex\\\\.(dead_session|turn_decision|reconnect|session_ready)|missing own-token hidden states\"",
          "queryType": "range",
          "refId": "A"
        }
      ]
    }
