{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "title": "Agent logs",
      "type": "link",
      "url": "/d/speechagent-logs/agent-logs",
      "icon": "doc"
    },
    {
      "title": "Realtime stream",
      "type": "link",
      "url": "/d/speechagent-stream/realtime-stream",
      "icon": "bolt"
    },
    {
      "title": "Ada GPU",
      "type": "link",
      "url": "/d/speechagent-gpu/ada-gpu",
      "icon": "monitor"
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Events / sec by event type",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "unit": "cps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (event) (count_over_time({compose_project=\"speechagent\", event=~\".+\"}[1m]))",
          "legendFormat": "{{event}}",
          "queryType": "range",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Barge-ins (range)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "barge-in",
          "expr": "sum(count_over_time({compose_project=\"speechagent\", event=\"turn.barge_in\"}[$__range]))"
        }
      ]
    },
    {
      "id": 6,
      "title": "Model WS retries (range)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 4 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "duplex.ws_retry",
          "expr": "sum(count_over_time({compose_project=\"speechagent\", event=\"duplex.ws_retry\"}[$__range]))"
        }
      ]
    },
    {
      "id": 3,
      "title": "Turn latency (unwrap latency_ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "refId": "p50",
          "legendFormat": "p50",
          "expr": "quantile_over_time(0.5, {compose_project=\"speechagent\", event=~\".+\"} | json | unwrap latency_ms | __error__=\"\" [1m])"
        },
        {
          "refId": "p95",
          "legendFormat": "p95",
          "expr": "quantile_over_time(0.95, {compose_project=\"speechagent\", event=~\".+\"} | json | unwrap latency_ms | __error__=\"\" [1m])"
        }
      ]
    },
    {
      "id": 4,
      "title": "First audio latency (qwen.first_audio / duplex.speak)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{event}}",
          "expr": "avg_over_time({compose_project=\"speechagent\", event=~\"qwen.first_audio|duplex.speak\"} | json | unwrap latency_ms | __error__=\"\" [1m])"
        }
      ]
    },
    {
      "id": 5,
      "title": "SA_TRACE stream (newest first)",
      "type": "logs",
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "expr": "{compose_project=\"speechagent\", event=~\".+\"}",
          "queryType": "range",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["speechagent"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "browser",
  "title": "Agent traces",
  "uid": "speechagent-traces",
  "version": 1
}
